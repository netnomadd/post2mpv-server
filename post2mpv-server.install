post_install() {
    echo ""
    echo "==> post2mpv установлен (user unit → graphical-session.target)."
    echo ""
    echo "  Задайте токен авторизации:"
    echo "    mkdir -p ~/.config/post2mpv"
    echo "    echo 'POST2MPV_TOKEN=ваш_токен' > ~/.config/post2mpv/post2mpv.conf"
    echo ""
    echo "  Включить и запустить (нужна активная графическая сессия):"
    echo "    systemctl --user daemon-reload"
    echo "    systemctl --user enable --now post2mpv"
    echo ""
    echo "  Если mpv не видит дисплей — перезапустите сервис после логина"
    echo "  или проверьте переменные сессии:"
    echo "    systemctl --user show-environment | grep -E 'DISPLAY|WAYLAND'"
    echo "    systemctl --user restart post2mpv"
    echo ""
}

post_upgrade() {
    echo ""
    echo "==> post2mpv обновлён. Перезагрузите user unit:"
    echo "    systemctl --user daemon-reload"
    echo "    systemctl --user restart post2mpv"
    echo ""
}
